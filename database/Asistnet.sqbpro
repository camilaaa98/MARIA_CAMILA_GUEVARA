><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="instructores" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="80"/><column index="2" value="69"/><column index="3" value="77"/><column index="4" value="54"/><column index="5" value="46"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">CREATE TABLE IF NOT EXISTS &quot;instructores&quot; (
    &quot;id_instructor&quot; INTEGER,
    &quot;id_usuario&quot; INTEGER NOT NULL UNIQUE,
    &quot;especialidad&quot; TEXT NOT NULL,
    &quot;telefono&quot; TEXT,
    &quot;estado&quot; INTEGER DEFAULT 1,
    PRIMARY KEY(&quot;id_instructor&quot;),
    FOREIGN KEY(&quot;id_usuario&quot;) REFERENCES &quot;usuarios&quot;(&quot;id_usuario&quot;)
        ON UPDATE NO ACTION ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS &quot;administracion&quot; (
    &quot;id_admin&quot; INTEGER,
    &quot;id_usuario&quot; INTEGER NOT NULL UNIQUE,
    &quot;cargo&quot; TEXT NOT NULL,
    &quot;nivel_acceso&quot; TEXT NOT NULL,
    &quot;estado&quot; INTEGER DEFAULT 1,
    PRIMARY KEY(&quot;id_admin&quot;),
    FOREIGN KEY(&quot;id_usuario&quot;) REFERENCES &quot;usuarios&quot;(&quot;id_usuario&quot;)
        ON UPDATE NO ACTION ON DELETE CASCADE
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
